# Copy to .env and fill in. Local launchd jobs load this via python-dotenv.
# Do NOT commit .env (already in .gitignore).

# LLMs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Telegram capture bot
TELEGRAM_CAPTURE_BOT_TOKEN=
TELEGRAM_CAPTURE_CHANNEL_ID=

# Where the second-brain repo is checked out locally (vault for direct read by Obsidian)
SECOND_BRAIN_PATH=/Users/artur/Documents/vault/10-second-brain

# Where the personal vault root is (for Personal Brand handoff appends)
VAULT_PATH=/Users/artur/Documents/vault

# Enable git push on every commit (1 = push, 0 or unset = local commit only)
KM_GIT_PUSH=1

# Optional — long-poll seconds (0 = short poll, OK for 5-min cron cadence)
KM_TG_POLL_TIMEOUT=0
